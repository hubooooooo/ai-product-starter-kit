# 复制为 backend/.env 后填写。backend/.env 已被 .gitignore 忽略，不会进仓库。
# 线上（云托管）不用这个文件：同名变量填在云托管控制台的"环境变量"里。

# ---------- 模型 ----------
# 模型 Key：火山方舟控制台 → API Key 管理 → 创建，粘贴到等号后面（不要加引号、不要发到对话里）
MODEL_API_KEY=
# 火山方舟 OpenAI 兼容地址
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID：以方舟控制台"模型广场 / 在线推理"里实际可用的豆包轻量模型 ID 为准
MODEL_NAME=doubao-seed-1-6-flash-250828
# 单次模型调用超时（秒）和网络类错误的额外重试次数
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_RETRIES=1

# ---------- 数据库 ----------
# 本地默认放在产品文件夹的 data/ 下（已被 .gitignore 忽略）
# 线上填云开发 PostgreSQL 的内网地址，格式：postgresql+psycopg://用户名:密码@内网地址:5432/库名
#   （需要 SSL 时在末尾加 ?sslmode=require）
DATABASE_URL=sqlite:///../data/app.db

# ---------- 数据后端 ----------
# 留空或 sql = 用上面的 DATABASE_URL；cloudbase_rest = 经腾讯云开发 PostgreSQL 的 HTTPS 网关读写（线上用）
# 本地 .env 里保持留空：pytest 和 restart-check 也会读这个文件，写成 cloudbase_rest 会让测试去连真实云库。
# 本地连云库冒烟时，只在那一次命令前临时加 DATA_BACKEND=cloudbase_rest。
DATA_BACKEND=
# 云开发环境 ID（控制台左上角，形如 xxx-1a2b3c）；网关地址由它推出
CLOUDBASE_ENV_ID=
# 服务端 API Key：云开发控制台 → API Key 管理 → 创建"API Key"（不是 Publishable Key）。只填在这里或平台环境变量里
CLOUDBASE_API_KEY=
# 可选：网关地址，不填 = https://<环境ID>.api.tcloudbasegateway.com/v1/rdb/rest
CLOUDBASE_REST_URL=

# ---------- 登录（上线时开启；本地不填 = 免登录本机模式） ----------
# 1 = 必须用邀请码登录，数据按人隔离
REQUIRE_LOGIN=
# 邀请码：码1:标签1,码2:标签2 —— 一人一码，标签就是这个人的身份；给某人换码时保留原标签，历史就不会丢
INVITE_CODES=
# 会话签名密钥：至少 16 位随机字符（由 AI 生成，只填在这里或平台环境变量里）
SESSION_SECRET=
# 1 = Cookie 只走 HTTPS（线上必须为 1；本地 http 调试留空）
COOKIE_SECURE=
# 登录有效天数（默认 7）
SESSION_MAX_AGE_DAYS=7
# 服务前面有几层可信代理（用于登录失败限流识别来源 IP；本地 0）
PROXY_HOPS=0
# 平台网关写入、客户端无法伪造的来源 IP 头（镜像里默认 x-envoy-external-address；本地留空）
CLIENT_IP_HEADER=
# 前端（Next 代理）与后端共享的密钥，至少 16 位随机字符；前后端两个服务填同一个值。
# 只有带着这个值的请求，后端才信任它的 x-client-ip（访客真实 IP，用于登录限流）。不填 = 不信任
PROXY_SHARED_SECRET=

# ---------- 防刷 ----------
# 每人每天最多生成几次（北京时间自然日，默认 50）
DAILY_GENERATION_LIMIT=50
